# SWORD — .env
# คัดลอกไฟล์นี้เป็นชื่อ ".env" (ไม่มีนามสกุล) แล้วกรอกค่าจริงแทน placeholder
# hybrid_nids.py และ telegram_module/telegram_alert.py เรียก load_dotenv()
# อยู่แล้ว จะอ่านไฟล์ ".env" นี้อัตโนมัติตอนรัน (ไม่ต้อง import อะไรเพิ่ม)
#
# ค่าพวกนี้ใช้เฉพาะตอนเปิดใช้ Telegram alert (utils/dataset_balancer.py,
# telegram_module/) — ถ้าแค่จะเทรนโมเดล (hybrid_nids.py --train,
# train_payload.py, build_web_payload_dataset.py) ไม่ต้องกรอกก็รันได้เลย
# ไม่มีไฟล์นี้ก็ไม่ error แค่ os.getenv() จะได้ None แล้วโค้ดจะแจ้งว่า
# credential ไม่ครบเฉยๆ

# ── Telegram Bot (สำหรับส่ง alert) ──────────────────────────────────
# 1) เปิดแชทกับ @BotFather ใน Telegram พิมพ์ /newbot ทำตามขั้นตอน
#    จะได้ token รูปแบบ 123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_TOKEN=

# 2) chat_id ปลายทางที่จะให้บอทส่งข้อความไปหา — ถ้าส่งเข้าแชทส่วนตัว
#    เปิดแชทกับ @userinfobot แล้วพิมพ์อะไรไปหาบอทนั้น มันจะบอก chat id
#    กลับมา (ถ้าเป็นกลุ่ม chat_id จะติดลบ)
TELEGRAM_CHAT_ID=

# ── Telegram API (สำหรับ telethon — ใช้ทดสอบ/ตรวจสอบ chat_id เพิ่มเติม
#    ใน telegram_alert.py) ────────────────────────────────────────
# 3-4) เข้า https://my.telegram.org/apps ล็อกอินด้วยเบอร์ตัวเอง
#      สร้าง App ใหม่ (ชื่ออะไรก็ได้) จะได้ api_id (ตัวเลข) และ
#      api_hash (สตริง hex) มาคู่กัน
API_ID=
API_HASH=
